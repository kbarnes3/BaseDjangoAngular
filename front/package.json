    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.1.4",
    "@types/webpack-env": "^1.18.8",
    "git-describe": "^4.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
