# Example secrets for the dev deployment of newdjangosite.
# Copy this whole secrets-example directory into a private Git repo, replace every
# value below, and point the repo at fabric_utils/deploy.py's secret_repo_name.
# back/newdjangosite/settings_dev.py reads this file from
# /var/www/python/newdjangosite-dev-secrets/dev/dev.env

# Django secret key. Generate a fresh one per deployment with:
#     uv run python secret_key.py
SECRET_KEY=replace-me-with-the-output-of-secret_key.py

# Password for the newdjangosite_dev_user Postgres role. This value is applied to the
# role by back/create_db.py, so changing it here and re-running that script rotates it.
# Shell escape characters are not supported.
DATABASE_PASSWORD=replace-me

# Outbound SMTP credentials.
EMAIL_HOST=smtp.yourdomain.tld
EMAIL_PORT=465
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_SSL=True

# Sender address. Must be verified with the SMTP provider above or mail is rejected.
DEFAULT_FROM_EMAIL=djangositeemail@example.com